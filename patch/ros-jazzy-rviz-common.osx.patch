 void
 RosClientAbstraction::shutdown()
 {
+#ifdef __APPLE__
+  // On macOS, tearing down the rclcpp node during process shutdown can crash in
+  // rclcpp::CallbackGroup destruction after Qt/RViz display teardown. The
+  // process is exiting, so keep the node alive and let the OS reclaim it.
+  auto leaked_rviz_ros_node =
+    new std::shared_ptr<RosNodeAbstractionIface>(std::move(rviz_ros_node_));
+  static_cast<void>(leaked_rviz_ros_node);
+#else
+  rviz_ros_node_.reset();
+#endif
   rclcpp::shutdown();
 }
 
